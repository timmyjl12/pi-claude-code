{
  "name": "@timmyjl12/pi-claude-code",
  "version": "0.1.0",
  "description": "Experimental pi provider for Claude Pro/Max subscriptions through Claude Code",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmyjl12/pi-claude-code.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "claude",
    "claude-code",
    "anthropic"
  ],
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --disable-warning=DEP0205 --import jiti/register --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^22.19.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "homepage": "https://github.com/timmyjl12/pi-claude-code#readme",
  "bugs": {
    "url": "https://github.com/timmyjl12/pi-claude-code/issues"
  }
}
